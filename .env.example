# MiTH Terminal — Optional Environment Configuration
# Copy to .env if you want custom local overrides (never commit real secrets).

# TCP port for the MiTH Terminal HTTP + WebSocket daemon (default: 8790)
PORT=8790

# Optional Gemini API key to enable the built-in mobile AI terminal assistant
GEMINI_API_KEY=

# Set to 1 to disable automatic cloudflared binary download / Quick Tunnel startup
MITH_NO_AUTO_CLOUDFLARED=0
